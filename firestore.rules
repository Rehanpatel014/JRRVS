rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Student user profiles
    match /users/{userId} {
      allow read, write: if true;

      // Student order bookings and tracking
      match /orders/{orderId} {
        allow read, write: if true;
      }
    }

    // Master orders ledger for Admin portal & store overview
    match /all_orders/{orderId} {
      allow read, write: if true;
    }

    // Live inventory management
    match /inventory/{productId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
